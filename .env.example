# Environment variable template for Scam Squad.
#
# Copy this file to "server/.env" and fill in real values.
# The frontend has its own template at client/.env.example.
# Never commit a real .env file - it contains secrets.

# ---- Server ----
PORT=3001
NODE_ENV=development

# URL of the frontend, used for CORS
CLIENT_URL=http://localhost:5173

# ---- Database ----
# MongoDB Atlas connection string
MONGODB_URI=your-mongodb-atlas-connection-string

# Upstash Redis connection URL
REDIS_URL=your-upstash-redis-url

# ---- Authentication ----
# Any long random string used to sign JWTs
JWT_SECRET=your-jwt-secret

# ---- Email (2FA via Gmail SMTP) ----
GMAIL_USER=your-gmail-address
GMAIL_APP_PASSWORD=your-gmail-app-password
