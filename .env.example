# Backend environment template.
# Copy this to server/.env (which is git-ignored):  cp .env.example server/.env

# Port the Express server listens on.
PORT=3001

# MongoDB Atlas connection string (free tier). The server refuses to
# start without a valid one.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/scam_squad

# Secret used to sign JWTs. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Frontend origin allowed through CORS (the Vite dev server).
CLIENT_URL=http://localhost:5173

# Redis connection URL (Upstash free tier uses a rediss:// URL).
# Optional - if unset, the server still starts. Redis is used to store
# 2FA codes when present; without it an in-memory fallback is used.
REDIS_URL=

# Gmail SMTP for 2FA one-time-code emails. Optional: if SMTP_USER /
# SMTP_PASS are empty, OTP codes are logged to the server console
# instead of emailed (fine for development).
# SMTP_PASS must be a Gmail App Password, not the account password.
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
