# Frontend environment template.
# Copy this to client/.env (which is git-ignored) and adjust as needed.

# Base URL of the backend API. Vite only exposes vars prefixed with VITE_.
# Defaults to the local backend if unset; set this to the Railway URL in
# production (e.g. https://your-app.up.railway.app/api).
VITE_API_URL=http://localhost:3001/api
