# Client environment variables.
# Copy this file to ".env" inside /client and adjust the values.
# Only variables prefixed with VITE_ are exposed to the frontend code.

# Base URL of the backend REST API
VITE_API_URL=http://localhost:3001/api

# Base URL of the Socket.io server (real-time co-op gameplay)
VITE_SOCKET_URL=http://localhost:3001
